# Copiá este archivo a .env.local (no se sube a git) para desarrollo local.
# En producción (Vercel), cargá estas mismas variables en:
# Project Settings → Environment Variables.

# Access Token de Mercado Pago (Checkout Pro). Se obtiene en:
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# URL pública del sitio, usada para las back_urls de Mercado Pago y el
# webhook de notificaciones de pago.
# En Vercel podés usar la URL del deployment, ej: https://club-del-antojo.vercel.app
NEXT_PUBLIC_SITE_URL=

# Base de datos (Turso). Sin estas dos variables, la app usa un archivo
# SQLite local (./local.db) — sirve para desarrollo pero no persiste en
# Vercel. Creá una base gratis en https://turso.tech y pegá acá:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Panel de administración (/admin). Elegí una contraseña propia y un
# secreto random largo (podés generarlo con: openssl rand -hex 32).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Carga de fotos de productos (Vercel Blob). En Vercel: Project → Storage →
# Create Database → Blob, y se conecta solo (te crea esta variable). En
# local no hace falta: sin ella, subir imágenes va a fallar, pero el resto
# de la app funciona igual.
BLOB_READ_WRITE_TOKEN=

# Notificaciones push para repartidores (Web Push / VAPID). Generadas una
# sola vez para este proyecto — se pueden regenerar con:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública es NEXT_PUBLIC (va al navegador); la privada nunca se expone.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@clubdelantojo.com
